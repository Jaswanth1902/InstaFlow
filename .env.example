# InstaFlow Configuration

# Instagram Web Direct API Session Cookies (From browser DevTools)
INSTAGRAM_SESSION_ID=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_CSRF_TOKEN=

# Polling interval and jitter (in seconds)
POLL_INTERVAL_SECONDS=60
POLL_JITTER_SECONDS=5

# Optional: Restrict auto-replies to specific sender handles (comma-separated, leave blank for all)
ALLOWED_SENDER_USERNAMES=

# Download reel videos via yt-dlp (optional)
DOWNLOAD_REEL_VIDEOS=false

# Operating Modes
ENABLE_INTERACTIVE_REPLIES=true
DRY_RUN=false
